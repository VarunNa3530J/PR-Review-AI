# ==============================================================================
# PR-Review-AI Environment Configuration Template
# ==============================================================================
#
# QUICK START:
#
# 1. LOCAL DEVELOPMENT (Using safe local defaults):
#      cp infra/.env.example infra/.env
#      # Optional host port access (Postgres: 5432, Redis: 6379):
#      docker compose -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d
#      # Standard containerized stack:
#      docker compose -f infra/docker-compose.yml up --build -d
#
# 2. PRODUCTION DEPLOYMENT:
#      cp infra/.env.example infra/.env
#      # Fill in all REQUIRED PRODUCTION SECRETS below (no dummy values allowed).
#      # Generate secure random keys (32+ chars):
#      #   openssl rand -hex 32
#      docker compose --env-file infra/.env -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up --build -d
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments. 'local' for development.
APP_ENV=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SECURITY KEYS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Minimum 32 characters required by application validators.
# In production, generate distinct, high-entropy random keys:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SIGNING_KEY=change_me_to_a_random_32_bytes_string_minimum_length
FIELD_ENCRYPTION_KEY=change_me_to_a_random_32_bytes_base64_or_hex_key

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# NOTE: In Docker Compose, the database service is named 'postgres' and Redis
# is named 'redis'. Ports are NOT exposed to the host by default.
# For production, set a strong, unique POSTGRES_PASSWORD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production_to_strong_db_password
POSTGRES_DB=prreview
DATABASE_URL=postgresql+psycopg://postgres:change_me_in_production_to_strong_db_password@postgres:5432/prreview
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI API (MANDATORY FOR AI REVIEWS)
# ------------------------------------------------------------------------------
# Generate API key at: https://aistudio.google.com/app/apikey
# In production, GEMINI_KEY_TIER must be set to 'paid' (or 'free' for testing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_KEY_TIER=free
LLM_REVIEW_MODEL=gemini-2.5-flash
LLM_LIGHT_MODEL=gemini-2.0-flash
LLM_PRICE_REVIEW_IN_PER_M=750000
LLM_PRICE_REVIEW_OUT_PER_M=3750000
LLM_PRICE_LIGHT_IN_PER_M=300000
LLM_PRICE_LIGHT_OUT_PER_M=2500000

# Review Studio Limits
MAX_FILES_PER_REVIEW=40
MAX_LINES_PER_REVIEW=2000
MAX_TOKENS_PER_REVIEW=30000

# ------------------------------------------------------------------------------
# 5. GITHUB APP INTEGRATION (MANDATORY FOR PULL REQUEST WEBHOOKS)
# ------------------------------------------------------------------------------
# Create and configure GitHub App at: https://github.com/settings/apps
# GITHUB_APP_PRIVATE_KEY should contain the PEM RSA private key content or multiline string.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=pr-review-ai-dev
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key_here
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 6. WEB FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Publicly accessible URL for client browsers to reach FastAPI gateway
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/pr-review-ai-dev/installations/new

# ------------------------------------------------------------------------------
# 7. BILLING, MONITORING & NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
REVIEWS_PAUSED=false
DAILY_SPEND_ALARM_USD=50
ERROR_TRACKING_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=alerts@prreview.ai
