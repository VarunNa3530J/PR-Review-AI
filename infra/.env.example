# ==============================================================================
# PR-Review-AI Environment Configuration Example
# ==============================================================================
#
# QUICK START:
# - For Local Development:
#     cp infra/.env.example infra/.env
#     docker compose -f infra/docker-compose.yml up --build
#
# - For Production Deployment:
#     docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up --build
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & LOCAL DEVELOPMENT SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Security Keys (Must be >= 32 characters. Replace with high-entropy secrets in production)
SESSION_SIGNING_KEY=dev_session_signing_key_32_characters_minimum_example
FIELD_ENCRYPTION_KEY=dev_field_encryption_key_32_chars_min_example!

# Database & Cache (PostgreSQL 16 & Redis 7)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=prreview
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@postgres:5432/prreview
REDIS_URL=redis://redis:6379/0

# Review Studio Limits
MAX_FILES_PER_REVIEW=40
MAX_LINES_PER_REVIEW=2000
MAX_TOKENS_PER_REVIEW=30000

# Safety Switches
REVIEWS_PAUSED=false
DAILY_SPEND_ALARM_USD=50
ERROR_TRACKING_DSN=

# Web Frontend Config
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/pr-review-ai-dev/installations/new

# ------------------------------------------------------------------------------
# 2. THIRD-PARTY CREDENTIALS & PRODUCTION SECRETS
# ------------------------------------------------------------------------------
# In production, these must be set with valid credentials.
# For local evaluation, dummy values are provided to allow the stack to initialize.

# Google Gemini API (Generate at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=dummy_gemini_api_key
GEMINI_KEY_TIER=free
LLM_REVIEW_MODEL=gemini-2.5-flash
LLM_LIGHT_MODEL=gemini-2.0-flash
LLM_PRICE_REVIEW_IN_PER_M=750000
LLM_PRICE_REVIEW_OUT_PER_M=3750000
LLM_PRICE_LIGHT_IN_PER_M=300000
LLM_PRICE_LIGHT_OUT_PER_M=2500000

# GitHub App Integration (Configure at: https://github.com/settings/apps)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=pr-review-ai-dev
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=dev_webhook_secret_key_123456
GITHUB_OAUTH_CLIENT_ID=dummy_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=dummy_github_oauth_client_secret

# Billing & Notifications (Optional)
RAZORPAY_KEY_ID=dummy_rzp_test_key_id
RAZORPAY_KEY_SECRET=dummy_rzp_test_key_secret
RAZORPAY_WEBHOOK_SECRET=dummy_rzp_webhook_secret
EMAIL_PROVIDER_API_KEY=dummy_email_key
EMAIL_FROM=alerts@prreview.ai
